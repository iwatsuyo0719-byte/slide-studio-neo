{
  "name": "slide-studio-neo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "app": "npm run build && npm start",
    "doctor": "node --import tsx scripts/doctor.ts",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx --test tests/*.e2e.ts",
    "test:http": "node --import tsx --test tests/http.e2e.ts",
    "test:browser": "node --import tsx --test tests/browser.e2e.ts"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "optionalDependencies": {
    "gsap": "^3.14.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "tsx": "4.23.12"
  },
  "type": "module"
}
